# Session encryption key (required, auto-generated by installer)
AUTH_SECRET=

# ── Login Protection ──
# Block an IP after 10 failed logins within 10 minutes, for 15 minutes.
LOGIN_MAX_ATTEMPTS=10
LOGIN_ATTEMPT_WINDOW=600
LOGIN_BLOCK_SECONDS=900

# ── Mail Server (Optional Override) ──
# By default, the app auto-discovers mail servers via MX DNS records.
# Example: login with user@gmail.com → resolves gmail.com MX → imap.gmail.com
# Only set these if you need to force a specific server for ALL domains.
IMAP_HOST=
IMAP_PORT=993
IMAP_SECURE=true
# Set IMAP_SECURE=false when the IMAP server only speaks plain IMAP on port 143.

SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true

# Primary webmail domain, served from /etc/caddy/Caddyfile (set by the installer).
# The admin panel refuses to add this one as an extra domain: two site blocks for
# the same host would make Caddy reject the config.
PRIMARY_DOMAIN=

# Extra domains added in the admin panel are written to this include file only,
# never to /etc/caddy/Caddyfile. It is loaded via `import /etc/caddy/*.conf`.
ENABLE_CADDY_AUTOMATION=true
CADDY_ALIASES_PATH=/etc/caddy/bnix-webmail.conf

# ── CalDAV / CardDAV (Optional) ──
# For calendar & contacts. Only needed if your mail server supports DAV.
DAV_HOST=
DAV_PORT=2080
DAV_SECURE=false

# ── Server ──
# The systemd unit always forces HOST=127.0.0.1; put a reverse proxy in front.
HOST=127.0.0.1
PORT=8000

# ── Data Directory ──
# Mail settings, signatures, contacts, calendar, labels and rules.
# Production systemd sets this to /opt/bnix-webmail/data.
DATA_DIR=

# ── Single sign-on from a hosting panel (optional) ──
# A panel that runs the mail server (OPanel) signs a 60-second, single-use link
# to /sso with SSO_SECRET; the session then reaches IMAP/SMTP as this Dovecot
# master user ("mailbox*master"), so no mailbox password is needed or stored.
# Off unless all three are set.
SSO_SECRET=
SSO_MASTER_USER=
SSO_MASTER_PASSWORD=
SSO_MASTER_SEPARATOR=*
