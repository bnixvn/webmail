# BNIX Webmail primary site.
#
# The admin alias panel writes enabled aliases to /etc/caddy/bnix-webmail.conf.
# Keep the import below so Caddy can serve those aliases without letting the
# web app rewrite /etc/caddy/Caddyfile.

webmail.example.com {
    reverse_proxy 127.0.0.1:8000
}

import /etc/caddy/*.conf
