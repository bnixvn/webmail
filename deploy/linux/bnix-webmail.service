[Unit]
Description=BNIX Webmail (FastAPI)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=bnix-webmail
Group=bnix-webmail
WorkingDirectory=/opt/bnix-webmail/src/backend
EnvironmentFile=-/etc/bnix-webmail.env
Environment=DATA_DIR=/opt/bnix-webmail/data
Environment=HOST=127.0.0.1
Environment=PORT=8000
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/bnix-webmail/venv/bin/python /opt/bnix-webmail/src/backend/main.py
Restart=always
RestartSec=5
PrivateTmp=true
ProtectSystem=full
# The "-" prefix keeps the unit startable if the Caddy fragment is absent
# (e.g. Caddy removed later); without it systemd refuses to start the service.
ReadWritePaths=/opt/bnix-webmail/data -/etc/caddy/bnix-webmail.conf

[Install]
WantedBy=multi-user.target
